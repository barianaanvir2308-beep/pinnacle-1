extends Node

# Existing signals
signal tower_placed(tower_type: int, grid_pos: Vector2i)
signal tower_sold(tower_type: int, grid_pos: Vector2i, refund: int)
signal tower_upgraded(tower_type: int, grid_pos: Vector2i, path: String, tier: int)
signal ability_used(tower_node: Node, ability_id: String)
signal tower_repaired(tower_node: Node, cost: int)
signal system_load_changed(load_value: float, max_load: float)
signal system_crashed()
signal overclock_used(energy: int)
signal tower_selected(tower_node: Node)
signal tower_deselected()
signal enemy_spawned(enemy_node: Node)
signal enemy_defeated(enemy_type: int, reward: int, position: Vector2)
signal enemy_reached_base(enemy_type: int, damage: int)
signal enemy_split(position: Vector2, count: int, enemy_data: Dictionary)
signal wave_started(wave_number: int)
signal wave_completed(wave_number: int, bonus: int)
signal all_waves_completed()
signal wave_enemy_count_changed(remaining: int)
signal game_state_changed(old_state: int, new_state: int)
signal game_over()
signal victory()
signal game_paused()
signal game_resumed()
signal energy_changed(new_amount: int)
signal energy_insufficient(required: int, available: int)
signal base_health_changed(new_health: int, max_health: int)
signal base_damaged(damage: int, remaining_health: int)
signal show_message(text: String, duration: float)
signal tower_placement_started(tower_type: int)
signal tower_placement_cancelled()
signal placement_invalid(reason: String)

# New signals
signal worm_spread(position: Vector2, health_mult: float, speed_mult: float, hit_modules: Array)
signal level_selected(level_index: int)
signal level_completed(level_index: int)
signal tower_destroyed(tower_type: int, grid_pos: Vector2i)
signal overclock_ready()  # the Overclock cooldown has finished (sound now, hardware LED later)
signal hardware_connection_changed(connected: bool)  # the Arduino console was plugged in or lost (hardware_link.gd)
