; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Protocol Zero"
config/description="Tower Defence Game - Protect the Arduino from virus attacks"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/2d_panning_strength=0.3

[autoload]

Globals="*res://autoloads/globals.gd"
Events="*res://autoloads/events.gd"
Audio="*res://autoloads/audio.gd"
ResourceManager="*res://scripts/managers/resource_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1360
window/stretch/mode="canvas_items"

