[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="1"]
script/source = "extends Node2D

var lifetime: float = 0.8
var timer: float = 0.0

func _process(delta: float) -> void:
	timer += delta
	if timer >= lifetime:
		queue_free()
	queue_redraw()

func _draw() -> void:
	var progress = timer / lifetime
	var radius = 30.0 + progress * 80.0
	var alpha = 1.0 - progress
	draw_circle(Vector2.ZERO, radius, Color(0.2, 0.6, 1.0, alpha * 0.5))
	draw_arc(Vector2.ZERO, radius, 0, TAU, 32, Color(0.0, 1.0, 1.0, alpha), 3.0)
"

[node name="EMPBlast" type="Node2D"]
script = SubResource("1")
